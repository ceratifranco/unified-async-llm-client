# Proveedor por defecto: groq | openai | anthropic
LLM_PROVIDER=groq

# Groq — gratis, sin tarjeta: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# OpenAI (opcional, pago): https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Anthropic (opcional, pago): https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# Opcionales
LLM_TIMEOUT_S=30
LLM_MAX_RETRIES=3
